# Point the desktop at the local Alicorn control plane in auth mode `keycloak` (dev builds only).
# Stack: ALICORN_AUTH_MODE=keycloak pnpm alicorn:up. The tenant is the Keycloak organisation id,
# so members are seeded with ALICORN_TENANT_ID=<org id> pnpm alicorn:seed — see
# docs/alicorn/LOCAL-DEV.md section 2b, which also covers creating the organisation by hand.
#
# Source this INSTEAD of desktop.env.example, in a fresh shell. Sourcing both leaves
# ALICORN_LOCAL_API_TOKEN set, and the desktop would present the shared token to a stack that
# only accepts Keycloak ones — a 401 that looks like a sign-in bug.
export ALICORN_AUTH_MODE=keycloak
export ALICORN_CONTROL_API_URL=http://127.0.0.1:8081
export ALICORN_LEDGER_API_URL=http://127.0.0.1:8082

# The bearer and the org now come from the Orca Cloud session: Settings → Orca Account → Connect.
# The Control API brokers /v1/desktop/auth/* against Keycloak, so ORCA_CLOUD_API_URL is the
# Control API — but /authorize is Keycloak's own realm endpoint, which the broker does not serve.
export ORCA_CLOUD_API_URL=http://127.0.0.1:8081
export ORCA_CLOUD_CLIENT_ID=alicorn-desktop
export ORCA_CLOUD_AUTHORIZE_URL=http://127.0.0.1:8080/realms/alicorn/protocol/openid-connect/auth

# Loopback HTTP token endpoints are accepted only in unpackaged builds; a packaged Alicorn
# refuses them, so this block is for `pnpm dev` and nothing else.
